{
  "name": "scopehaven",
  "version": "0.7.0",
  "private": true,
  "description": "Local, deterministic checks of what an AI agent actually did in your app: effects, not replies.",
  "keywords": [
    "ai-agents",
    "agent-testing",
    "authorization",
    "access-control",
    "evidence",
    "audit",
    "security-testing",
    "mcp",
    "cli"
  ],
  "homepage": "https://github.com/YusefSyed/scopehaven-oss#readme",
  "bugs": { "url": "https://github.com/YusefSyed/scopehaven-oss/issues" },
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/YusefSyed/scopehaven-oss.git" },
  "type": "module",
  "bin": { "scopehaven": "scopehaven" },
  "files": [
    ".gitleaks.toml",
    ".node-version",
    ".nvmrc",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "NOTICE",
    "RELEASE-MANIFEST.json",
    "SBOM.cdx.json",
    "SECURITY.md",
    "action.yml",
    "design/",
    "docs/",
    "examples/",
    "integrations/",
    "packaging/",
    "public/",
    "scopehaven",
    "src/",
    "test/support/",
    "!**/*.test.mjs",
    "!docs/demo/false-success-refund.gif",
    "!integrations/frameworks/acceptance/",
    "!packaging/osv-snapshot.mjs"
  ],
  "os": ["!win32"],
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0 <25"
  },
  "publishConfig": { "access": "public" },
  "scripts": {
    "prepublishOnly": "test -f RELEASE-MANIFEST.json || { echo 'Publish the .tgz from packaging/build-release.mjs --npm, not this folder: see packaging/RELEASE.md' >&2; exit 1; }",
    "start": "node src/server.mjs",
    "test": "node test/support/bounded-run.mjs test/*.test.mjs integrations/*/*.test.mjs design/dashboard/adapter.test.mjs",
    "assess": "node src/cli.mjs",
    "check-config": "node src/cli.mjs --check-config",
    "connector-demo": "node examples/run-connector-demo.mjs",
    "gate": "node integrations/regression-gate/cli.mjs",
    "gate-demo": "node integrations/regression-gate/demo.mjs",
    "import-evaluation": "node integrations/evaluation-import/cli.mjs",
    "export": "node src/export-cli.mjs",
    "sequence": "node integrations/sequences/cli.mjs",
    "attest": "node integrations/attest/cli.mjs",
    "policy": "node integrations/policy-import/cli.mjs",
    "monitor": "node integrations/monitor/cli.mjs",
    "payments": "node integrations/payments-pack/cli.mjs"
  }
}
